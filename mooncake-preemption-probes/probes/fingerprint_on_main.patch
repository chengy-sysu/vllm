+@dataclass
+class MooncakeStoreWorkerMetadata(KVConnectorWorkerMetadata):
+    """Store jobs each rank finished, reported back to the scheduler.
+
+    Maps ``ReqMeta.save_seq`` to the number of ranks that are done with it. The
+    scheduler releases a job's GPU block references once the count reaches the
+    world size.
