+    ) -> "MooncakeStoreWorkerMetadata":
+        assert isinstance(other, MooncakeStoreWorkerMetadata)
+        for save_seq, count in other.completed_saves.items():
+            self.completed_saves[save_seq] = (
+                self.completed_saves.get(save_seq, 0) + count
+            )
+        return self
