+    def _det_digest(
+        self, addrs: list[list[int]], sizes: list[list[int]]
+    ) -> list[int] | None:
+        """Byte fingerprint of the KV each key covers, sampled from the GPU.
+
+        Taken from the same storage the transfer reads/writes, so a fingerprint
+        recorded before a put and one recorded after the matching get describe
+        the same key. They can only differ if the bytes changed between the two,
+        which for a key naming a fixed token range means the store no longer
+        holds that key's KV.
+        """
+        regions = getattr(self, "_det_regions", None)
+        if not regions:
+            return None
+        base, region_len, flat = regions[0]
+        positions: list[int] = []
+        for addr_group, size_group in zip(addrs, sizes, strict=True):
+            addr, size = addr_group[0], size_group[0]
+            off = addr - base
+            if off < 0 or off + size > region_len:
+                return None
+            step = max(1, size // _DET_SAMPLES)
+            positions.extend(off + j * step for j in range(_DET_SAMPLES))
+        idx = torch.tensor(positions, dtype=torch.long, device=flat.device)
+        vals = flat.index_select(0, idx).view(-1, _DET_SAMPLES).to(torch.int64)
+        return (vals * _DET_WEIGHTS.to(vals.device)).sum(dim=1).cpu().tolist()
+
