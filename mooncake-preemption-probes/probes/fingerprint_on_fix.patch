+def _kdig(keys: list[str], digests: list[int] | None) -> str:
+    """`hash:fingerprint` pairs, matched up offline across put and get."""
+    if digests is None:
+        return ""
+    # The full key, since tp_rank and group live in the prefix and each rank
+    # holds different heads for the same tokens.
+    return ",".join(f"{k}:{d}" for k, d in zip(keys, digests, strict=True))
+
+
+def _kshort(keys: list[str]) -> str:
