+    def _det_write(self, line: str) -> None:
+        """Per-process file, because these lines are far too long to survive the
+        interleaving of two ranks' stdout."""
+        f = getattr(self, "_det_f", None)
+        if f is None:
+            f = open(f"/tmp/det_{os.getpid()}.log", "a", buffering=1 << 20)
+            self._det_f = f
+        f.write(line + "\n")
