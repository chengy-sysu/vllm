+     def _sh_job_ran(self, req_meta: ReqMeta) -> None:
+         """Replay the pre-fix bare-counter ledger for one store job.
+ 
+         Must be called once per job at the point the old code made its gate
+         decision, i.e. the top of `_handle_request`. Hooking the real ledger's
+         mutators instead would miss every stale job, because the fixed code
+         returns at the liveness gate without ever reaching `discard_store_job`,
+         whereas the old gate keyed on the req_id entry alone: once a resumed
+         generation had re-registered the same req_id, a stale job sailed through
+         and decremented that generation's counter in its `finally`.
+         """
+         req_id = req_meta.req_id
+         with self.done_task_lock:
+             self._sh_jobs += 1
+             live = self.stored_requests.get(req_id) or set()
+             stale = req_meta.save_seq not in live
+             if req_meta.save_seq in self._sh_orphan_seqs:
+                 # Follow every orphan to its end: whether the old ledger still
+                 # had an entry for the reused req_id decides if it mis-charged.
+                 self._sh_orphan_ran += 1
++                self._mg_gate(req_id, req_meta.save_seq)
+                 logger.error(
+                     "SHADOW orphan-ran req=%s seq=%s stale=%s old_entry=%s "
+                     "old_counter=%s live=%s total=%d",
+                     req_id, req_meta.save_seq, stale, req_id in self._sh_count,
+                     self._sh_count.get(req_id), sorted(live), self._sh_orphan_ran)
+             if stale:
+                 if self._sh_orphans.get(req_id):
+                     self._sh_orphans[req_id] -= 1
+                 if req_meta.save_seq not in self._sh_retired_seqs:
+                     # The real ledger dropped a job that no retirement accounts
+                     # for. This is the new ledger erring, and must stay at 0.
+                     self._sh_real_dropped_live += 1
+                     logger.error(
+                         "SHADOW real-dropped-live req=%s seq=%s total=%d",
+                         req_id, req_meta.save_seq, self._sh_real_dropped_live)
+             if req_id not in self._sh_count:
+                 # The old ledger had already retired the entry, so the old gate
+                 # dropped this job's whole save. Harmless for a stale job, but a
+                 # silent data loss for a live one.
+                 if not stale:
+                     self._sh_would_skip += 1
+                     logger.error("SHADOW would-skip-save req=%s seq=%s total=%d",
+                                  req_id, req_meta.save_seq, self._sh_would_skip)
+                 return
+             # The old gate passed, so the old code stored and then decremented.
+             self._sh_count[req_id] -= 1
+             if stale:
+                 self._sh_mischarge += 1
+                 logger.error(
+                     "SHADOW mischarge req=%s stale_seq=%s live=%s old_counter=%d "
+                     "total=%d",
+                     req_id, req_meta.save_seq, sorted(live),
+                     self._sh_count[req_id], self._sh_mischarge)
+             if self._sh_count[req_id] < 0:
+                 self._sh_underflow += 1
+                 logger.error("SHADOW underflow req=%s old_counter=%d total=%d",
+                              req_id, self._sh_count[req_id], self._sh_underflow)
+             # This job's own save_seq is still in `live` here; the real discard
+             # happens in the handler's `finally`, exactly where the old decrement
+             # sat. So only *other* live jobs make a zero counter premature.
+             others = live - {req_meta.save_seq}
+             if self._sh_count[req_id] <= 0 and others:
+                 self._sh_zero_with_live += 1
+                 logger.error(
+                     "SHADOW zero-with-live req=%s old_counter=%d still_live=%s "
+                     "total=%d",
+                     req_id, self._sh_count[req_id], sorted(others),
+                     self._sh_zero_with_live)
+             if not stale and len(live) == 1 and self._sh_count[req_id] != 0:
+                 # Last live job of this generation, yet the old counter disagrees
+                 # about that: the ledgers have diverged for this req_id.
+                 self._sh_diverged += 1
+                 logger.error(
+                     "SHADOW diverged req=%s seq=%s old_counter=%d total=%d",
+                     req_id, req_meta.save_seq, self._sh_count[req_id],
+                     self._sh_diverged)
