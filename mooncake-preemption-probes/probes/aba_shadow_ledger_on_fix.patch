+     def _sh_del(self, req_id: str, why: str) -> None:
+         # Old retirement dropped the whole req_id entry; count the ones that had
+         # live jobs left, which is the state that makes the gate skip a save.
+         if why != "preempt" and self.stored_requests.get(req_id):
+             self._sh_deleted_live += 1
+             logger.error(
+                 "SHADOW deleted-with-live req=%s why=%s still_live=%s total=%d",
+                 req_id, why, sorted(self.stored_requests[req_id]),
+                 self._sh_deleted_live)
+         self._sh_count.pop(req_id, None)
+ 
+     def shadow_close(self, preempted, finished_req_ids) -> None:
+         """Replica of the pre-fix _close_ended_store_requests retirement."""
+         with self.done_task_lock:
+             for req_id in preempted:
+                 self._sh_del(req_id, "preempt")
+             for req_id in list(self._sh_count):
+                 if self._sh_count[req_id] == 0 and req_id in self._sh_finished:
+                     self._sh_finished.discard(req_id)
+                     self._sh_del(req_id, "finished-late")
+             for req_id in finished_req_ids:
+                 count = self._sh_count.get(req_id)
+                 if count == 0:
+                     self._sh_del(req_id, "finished")
+                 elif count is not None:
+                     self._sh_finished.add(req_id)
+             # The old retirement judge is `== 0`, so a counter that went negative
+             # can never satisfy it again. Once the request has also finished no
+             # further job will bump the counter back up, and the entry is stuck
+             # for good: finished_sending is never emitted and the scheduler holds
+             # the request's blocks for the rest of the run. That is the terminal
+             # state #51637 describes, so probe it as state, not as an event.
+             for req_id, count in self._sh_count.items():
+                 if count >= 0:
+                     continue
+                 if req_id not in self._sh_stuck_neg:
+                     self._sh_stuck_neg.add(req_id)
+                     logger.error("SHADOW stuck-negative req=%s old_counter=%d total=%d",
+                                  req_id, count, len(self._sh_stuck_neg))
+                 if req_id in self._sh_finished and req_id not in self._sh_stuck_final:
+                     self._sh_stuck_final.add(req_id)
+                     logger.error(
+                         "SHADOW stuck-forever req=%s old_counter=%d total=%d",
+                         req_id, count, len(self._sh_stuck_final))
+ 
